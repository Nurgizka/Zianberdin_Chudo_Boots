<Page x:Class="Zianberdin_Chudo_Boots.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProductPage" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Name="FIOTB" FontSize="16" Margin="5" FontWeight="Bold"/>

            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Поиск:" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                <TextBox Name="TBoxSearch" Width="250" FontSize="14" Margin="5" 
                         TextChanged="TBoxSearch_TextChanged" VerticalContentAlignment="Center"/>

                <TextBlock Text="Категория:" FontSize="14" Margin="15,5,5,5" VerticalAlignment="Center"/>
                <ComboBox Name="ComboCategory" Width="150" FontSize="14" Margin="5" 
                          SelectionChanged="ComboCategory_SelectionChanged" VerticalContentAlignment="Center"/>

                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                <ComboBox Name="ComboSort" Width="150" SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                    <ComboBoxItem Content="По возрастанию цены"/>
                    <ComboBoxItem Content="По убыванию цены"/>
                </ComboBox>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Name="TBCount" FontSize="14" Margin="5" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="1" Margin="10,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Column="0" Grid.RowSpan="5" Stretch="Uniform" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding ImagePath}" MaxHeight="100">
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="10,0"/>
                        <TextBlock Text="{Binding CategorY, StringFormat=Тип: {0}}" Grid.Column="1" Grid.Row="1" FontSize="16" Margin="10,5"/>
                        <TextBlock Text="{Binding SizesString, StringFormat=Размеры: {0}}" Grid.Column="1" Grid.Row="2" FontSize="14" Margin="10,5"/>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" FontSize="14" TextWrapping="Wrap" Margin="10,5"/>
                        <TextBlock Text="{Binding ProductCost, StringFormat=Цена: {0} руб.}" Grid.Column="1" Grid.Row="4" FontSize="18" FontWeight="Bold" Margin="10,5"/>
                        <TextBlock Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Text="{Binding Manufactures.ManufactureName, StringFormat= Производитель: {0}}"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Click="BtnPrev_Click" Width="80" Height="30" Margin="5"/>
                <TextBlock Name="TBPage" VerticalAlignment="Center" Margin="10,0" FontSize="14" FontWeight="Bold"/>
                <Button Content="Вперёд" Click="BtnNext_Click" Width="80" Height="30" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>